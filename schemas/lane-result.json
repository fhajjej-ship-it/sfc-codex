{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "evidence", "recovery"],
  "properties": {
    "verdict": {"type": "string", "enum": ["pass", "fail", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "severity", "message"],
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "message": {"type": "string"}
        }
      }
    },
    "recovery": {
      "description": "Use null unless requesting recovery for missing check evidence.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "check_ids"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "missing-check-evidence"
          ]
        },
        "check_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "One nonblank evidence text containing concrete files, observed behavior and checks actually run. Use paragraphs within this text; do not return an array or pad unused entries. Distinguish deferred checks and missing evidence honestly."
    }
  }
}
