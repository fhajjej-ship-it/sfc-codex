{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "findings",
    "evidence",
    "completed",
    "scope",
    "escalate",
    "coverage",
    "recovery"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "line",
          "severity",
          "message"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "One nonblank evidence text containing concrete files, observed behavior and checks actually run. Use paragraphs within this text; do not return an array or pad unused entries. Distinguish deferred checks and missing evidence honestly."
    },
    "completed": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "base",
        "config",
        "task",
        "policy",
        "verification",
        "obligation",
        "review_dependency"
      ],
      "properties": {
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        },
        "obligation": {
          "type": "string"
        },
        "review_dependency": {
          "type": "string"
        }
      }
    },
    "escalate": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "qa",
          "security",
          "human"
        ]
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "reason",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "covered",
              "qa_required"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "sha256"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "source",
                    "check",
                    "qa-command",
                    "prior-qa",
                    "retained"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "recovery": {
      "description": "Use null unless requesting recovery for missing check evidence.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "check_ids"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "missing-check-evidence"
          ]
        },
        "check_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
