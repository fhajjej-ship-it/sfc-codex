{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" --attachment --host=claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" --attachment --host=claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" --host=claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
